# Copy to .env and adjust. All settings are prefixed VITANOVA_.
VITANOVA_MONGO_URI=mongodb://localhost:27017
VITANOVA_MONGO_DB=vitanova

# Generate a real secret for anything but local dev:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
VITANOVA_JWT_SECRET=dev-only-secret-change-me-in-production
VITANOVA_ACCESS_TOKEN_TTL_MINUTES=30
VITANOVA_REFRESH_TOKEN_TTL_DAYS=7

VITANOVA_DEBUG=true

# CORS is only needed when the browser calls this API cross-origin. The deployed
# setup (see DEPLOYMENT.md) proxies /api through Vercel, so requests arrive
# same-origin and neither of these is required.
VITANOVA_CORS_ORIGINS=["http://localhost:4200"]
# For hosts whose name changes every deploy, e.g. Vercel previews:
# VITANOVA_CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Google Gemini API key, for the PDF resume import and the AI writing tools
# (/api/v1/ai/*: the writer, the bullet rewriter, the ATS score and the job
# matcher). Get one at https://aistudio.google.com. Leave it blank and the rest
# of the app is unaffected -- those endpoints switch off and say so when called.
#
# The free tier is 15 requests/minute. Every AI action is user-initiated and one
# request per user runs at a time, which keeps ordinary editing well inside it.
#
# This key is never sent to the browser: Angular calls FastAPI, FastAPI calls
# Gemini. This file is committed -- the real key belongs in .env, which is
# gitignored.
VITANOVA_GEMINI_API_KEY=

# Where the browser app lives. Confirmation and password-reset links are built
# against this, so it must be the public URL in a deployment.
VITANOVA_FRONTEND_BASE_URL=http://localhost:4200

# --- Outbound mail -----------------------------------------------------------
# Leave SMTP_HOST blank in development: mail is written to the server log
# instead of sent, so the confirmation link is right there in the console and no
# mail account is needed. A non-debug deployment refuses to start without it,
# because sign-in requires a confirmed address.
#
# Gmail wants an App Password (Google Account > Security > 2-Step Verification >
# App passwords), not your normal password:
#   VITANOVA_SMTP_HOST=smtp.gmail.com
#   VITANOVA_SMTP_PORT=587
#   VITANOVA_SMTP_USER=you@gmail.com
#   VITANOVA_SMTP_PASSWORD=your-16-char-app-password
#   VITANOVA_SMTP_FROM=VitaNova <you@gmail.com>
VITANOVA_SMTP_HOST=
VITANOVA_SMTP_PORT=587
VITANOVA_SMTP_USER=
VITANOVA_SMTP_PASSWORD=
# false for an implicit-TLS port such as 465
VITANOVA_SMTP_STARTTLS=true
VITANOVA_SMTP_FROM=VitaNova <no-reply@vitanova.app>

VITANOVA_EMAIL_VERIFICATION_TTL_HOURS=24
VITANOVA_PASSWORD_RESET_TTL_MINUTES=60

# --- Google Sign-In ----------------------------------------------------------
# OAuth 2.0 Client ID (type: Web application) from
# https://console.cloud.google.com/apis/credentials. Add your frontend origin
# under "Authorised JavaScript origins" -- http://localhost:4200 for dev.
# Blank hides the Google button entirely.
VITANOVA_GOOGLE_CLIENT_ID=
