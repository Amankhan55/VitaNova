# Copy to .env and adjust. All settings are prefixed VITANOVA_.
VITANOVA_MONGO_URI=mongodb://localhost:27017
VITANOVA_MONGO_DB=vitanova

# Generate a real secret for anything but local dev:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
VITANOVA_JWT_SECRET=dev-only-secret-change-me-in-production
VITANOVA_ACCESS_TOKEN_TTL_MINUTES=30
VITANOVA_REFRESH_TOKEN_TTL_DAYS=7

VITANOVA_DEBUG=true

# CORS is only needed when the browser calls this API cross-origin. The deployed
# setup (see DEPLOYMENT.md) proxies /api through Vercel, so requests arrive
# same-origin and neither of these is required.
VITANOVA_CORS_ORIGINS=["http://localhost:4200"]
# For hosts whose name changes every deploy, e.g. Vercel previews:
# VITANOVA_CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Google Gemini API key for AI resume import (free tier).
# Get one at https://aistudio.google.com
VITANOVA_GEMINI_API_KEY=
